{{!< default}}

<main class="site-main">

    <header class="gh-canvas">
        <h1 class="gh-page-title">Categorias</h1>
        <p class="gh-page-description">Explora todas as categorias disponíveis.</p>
    </header>

    <section class="gh-canvas">
        <ul class="gh-tag-list categoria-list">
            {{#get "tags" include="count.posts" limit="all" order="name asc"}}
                {{#foreach tags}}
                    <li class="gh-tag-list-item categoria-item">
                        <a class="gh-tag-card categoria-card" href="{{url}}">
                            <div class="categoria-image" style="height: 15rem; background-size: cover; {{#if feature_image}} background-image: url({{feature_image}});{{else}}background: white;{{/if}}" alt="{{name}}"></div>
                            <div class="categoria-info" style="background: {{#if accent_color}}{{accent_color}}{{else}}var(--ghost-accent-color){{/if}};">
                                <span class="gh-tag-name categoria-name">{{name}}</span>
                                <span class="gh-tag-count categoria-count">{{count.posts}}</span>
                            </div>
                        </a>
                    </li>
                {{/foreach}}
            {{/get}}
        </ul>
    </section>

</main>
