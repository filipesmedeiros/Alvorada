{{!< default}}

<main class="site-main">

    <header class="gh-canvas">
        <h1 class="gh-page-title">Categorias</h1>
        <p class="gh-page-description">Explora todas as categorias disponíveis.</p>
    </header>

    <section class="gh-canvas">
        <ul class="gh-tag-list">
            {{#get "tags" include="count.posts" limit="all" order="name asc"}}
                {{#foreach tags}}
                    <li class="gh-tag-list-item">
                        <a class="gh-tag-card categoria-card" href="{{url}}">
                            <img class="categoria-image" src="{{feature_image}}" alt="{{name}}">
                            <div class="categoria-info">
                                <span class="gh-tag-name categoria-name">{{name}}</span>
                                <span class="gh-tag-count categoria-count">{{count.posts}}</span>
                            </div>
                        </a>
                    </li>
                {{/foreach}}
            {{/get}}
        </ul>
    </section>

</main>
